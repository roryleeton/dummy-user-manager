{
    "name": "roryleeton/dummy-user-manager",
    "description": "Simple framework-agnostic package that provides a service for retrieving and creating users via a remote dummyjson API",
    "type": "library",
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "RoryLeeton\\DummyUserManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoryLeeton\\DummyUserManager\\Tests\\": "tests/"
        }
    },
    "require": {
        "psr/http-message": "^2.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1"
    }
}
